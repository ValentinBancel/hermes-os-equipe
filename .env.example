# Développement (Sail). En production, les variables sont saisies dans l'outil de déploiement :
# les valeurs par défaut sûres sont dans config/*.php (un .env ancien reste valable).
APP_NAME=hermes-os
# Nom du client affiché « pour <client> » sous le wordmark (vide = rien).
# HERMES_OS_CLIENT=
# Proxys de confiance : CIDR du reverse proxy (ex. 10.0.1.0/24), vide = aucun.
# HERMES_OS_TRUSTED_PROXIES=
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite (défaut)

# Sessions : en base, 30 min d'inactivité (12 h max, config/hermes-os.php), cookie chiffré SameSite=Strict.
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Dev en HTTP uniquement : la production garde le défaut `true` (config/session.php).
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log

# Accès aux données Hermes. `demo` = jeu de données figé, aucun accès au home Hermes.
# `socket` (alias historique `pont`) = pont sur la même machine : socket monté dans le conteneur + secret partagé.
# `distant` = Hermes relié depuis Compte (lot 04) : le pont sort en HTTPS vers APP_URL, rien à monter ni à ouvrir.
# Reste `demo` ici pour qu'un clone neuf démarre avec la démonstration ; passez à `distant` pour relier un vrai Hermes
# (README, « Relier un Hermes »).
HERMES_PONT_DRIVER=demo
# HERMES_PONT_SOCKET=/run/hermes-os/pont.sock
# HERMES_PONT_SECRET=
# États simulés en démonstration : nominal | tout_tourne | gateway_arrete | pont_injoignable
# HERMES_DEMO_ETAT=nominal
# Pilote distant (secondes) : relevé périmé, expiration d'une action en file, attente synchrone, long-poll max.
# HERMES_PONT_RELEVE_PERIME=60
# HERMES_PONT_ACTION_EXPIRATION=90
# HERMES_PONT_ATTENTE_ACTION=8
# HERMES_PONT_LONG_POLL=25

# Liste d'IP autorisées (CIDR séparés par des virgules). Vide = désactivée.
HERMES_OS_IP_ALLOWLIST=

# Sail : désactiver le serveur Vite de dev (assets buildés servis à la place).
# SAIL_VITE=0

VITE_APP_NAME="${APP_NAME}"

# Interrupteur de la page Messagerie ; true par défaut.
# HERMES_OS_MESSAGERIE=true
